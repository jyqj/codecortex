{
  "schema_version": 1,
  "database_schema": 25,
  "database_schema_compatibility": {
    "policy": "rebuild_on_mismatch",
    "contract_tests": ["crates/cc-db/tests/ci_schema_guard_contract.rs"]
  },
  "project_model_version": 3,
  "default_network": false,
  "runtime_executes_indexed_code": false,
  "module_owner": "crates/cc-index/src/module_resolution/mod.rs",
  "input_reader": "crates/cc-model/src/input_file.rs",
  "languages": {
    "typescript_javascript": {"modes": ["local_compat", "node10", "bundler", "node16", "nodenext"], "scope": "captured local/workspace declarations; not full compiler semantics", "tests": ["crates/cc-index/tests/p3a_project_model.rs", "crates/cc-index/tests/p3b_modules.rs"]},
    "rust": {"scope": "declared module paths and documented default-feature subset; not complete Cargo targets/feature unification", "tests": ["crates/cc-index/tests/p3b_modules.rs", "crates/cc-eval/tests/p3b_modules.rs"]},
    "python": {"scope": "static roots, relative imports, regular/namespace precedence; no runtime initialization/import hooks", "tests": ["crates/cc-index/tests/p3b_modules.rs", "crates/cc-index/tests/p3c_modules.rs"]},
    "go": {"scope": "portable unconditional non-test admitted local modules/workspaces/replaces; not MVS/cgo/host target", "tests": ["crates/cc-index/tests/p3c_modules.rs", "crates/cc-eval/tests/p3c_modules.rs"]},
    "vue_svelte": {"scope": "script importers share captured JS/TS rules; no arbitrary component transforms", "tests": ["crates/cc-index/tests/p3d_boundaries.rs"]},
    "other_module_rules": {"scope": "Unsupported rather than JavaScript path guessing", "tests": ["crates/cc-index/tests/p3d_boundaries.rs"]}
  },
  "gate_tests": ["crates/cc-eval/tests/p3d_modules.rs", "crates/cc-eval/tests/p3d_cost.rs", "crates/cc-index/tests/p3d_boundaries.rs"],
  "limits": {"config_bytes":1048576,"aggregate_config_bytes":16777216,"extends_depth":32,"input_path_components":256,"compact_source_bytes":4194304,"go_package_members":4096},
  "unverified_release_scope": ["full language/compiler equivalence","100k/RSS/tail latency","public holdouts","cross-platform remote CI","live embedding/OCE"]
}
