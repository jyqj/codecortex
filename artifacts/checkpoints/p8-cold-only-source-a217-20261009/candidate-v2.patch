+            /*
+            !/artifacts/
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          toolchain: 1.95.0
+      - name: Compile and bind one immutable release executable
+        run: |
+          python3 scripts/p8_cold_matrix.py build \
+            --root "$GITHUB_WORKSPACE" --output "$RUNNER_TEMP/p8-cold-build" \
+            --target-directory "$RUNNER_TEMP/p8-cold-cargo" \
+            --run-id "$GITHUB_RUN_ID" --attempt "$GITHUB_RUN_ATTEMPT"
+      - name: Preserve original build, binary and source receipts
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: p8-cold-build-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/p8-cold-build
+          if-no-files-found: error
+
+  # These are the new cold-only rep-0 measurements, counted exactly once.
+  # All five must pass before the remaining 145 cold-only slices run.
+  preflight:
+    needs: build
+    runs-on: ubuntu-24.04
+    timeout-minutes: 350
+    strategy:
+      fail-fast: false
+      max-parallel: 5
+      matrix:
+        scale: [100000, 50000, 10000, 5000, 1000]
+        shard: [0]
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          sparse-checkout-cone-mode: false
+          sparse-checkout: |
+            /*
+            !/artifacts/
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          toolchain: 1.95.0
+      - uses: actions/download-artifact@v4
+        with:
+          name: p8-cold-build-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/p8-cold-build
+      - name: Observe and prepare the registered capacity on this disposable hosted VM
+        env:
+          SCALE: ${{ matrix.scale }}
+          SHARD: ${{ matrix.shard }}
+          P8_EXPECTED_SOURCE: ${{ github.event.pull_request.head.sha || github.sha }}
+          P8_CAPACITY_PREPARE_ALLOWED: ${{ github.repository == 'jyqj/codecortex' && runner.environment == 'github-hosted' && runner.os == 'Linux' }}
+        run: |
