@@ -67,12 +67,23 @@ impl<'a> SnapshotWriteTxn<'a> {
         write_units: &[FileWriteUnit],
         chunk_blobs: &PrecompressedChunks,
     ) -> CcResult<()> {
-        for unit in write_units {
-            IndexDb::insert_snapshot_file_data_precompressed(
-                self.conn,
