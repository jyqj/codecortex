+            r#"{"s":"duplicate"}"#.to_string(),
+            r#"{"s":"é/中文\u0000tail"}"#.to_string(),
+            serde_json::to_string(&json!({"s": "x".repeat(20 * 1024)})).unwrap(),
+        ];
