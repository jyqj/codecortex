{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query",
  "type": "object",
  "properties": {
    "annotations": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "answers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnswerGroup"
      }
    },
    "category": {
      "type": "string"
    },
    "difficulty": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "expected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "no_answer": {
      "type": "boolean"
    },
    "path_prefix": {
      "type": [
        "string",
        "null"
      ]
    },
    "query": {
      "type": "string"
    },
    "query_family": {
      "type": "string"
    },
    "split": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "difficulty",
    "language",
    "split",
    "query_family",
    "query",
    "no_answer",
    "expected_files",
    "answers"
  ],
  "$defs": {
    "Alternative": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolGold"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "AnswerGroup": {
      "type": "object",
      "properties": {
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alternative"
          }
        },
        "grade": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "primary": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "primary",
        "grade",
        "alternatives"
      ]
    },
    "ByteSpan": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "SymbolGold": {
      "type": "object",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "qname": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    }
  }
}