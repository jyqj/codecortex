}\nfunction sha1(a){let h=[0x67452301,0xefcdab89,0x98badcfe,0x10325476,0xc3d2e1f0],b=pad(a);const rl=(x,n)=>(x<<n)|(x>>>(32-n));for(let i=0;i<b.length;i+=64){const w=[];for(let j=0;j<16;j++)w[j]=(b[i+j*4]<<24)|(b[i+j*4+1]<<16)|(b[i+j*4+2]<<8)|b[i+j*4+3];for(let j=16;j<80;j++)w[j]=rl(w[j-3]^w[j-8]^w[j-14]^w[j-16],1);let [a0,b0,c,d,e]=h;for(let j=0;j<80;j++){let f,k;if(j<20){f=(b0&c)|(~b0&d);k=0x5a827999;}else if(j<40){f=b0^c^d;k=0x6ed9eba1;}else if(j<60){f=(b0&c)|(b0&d)|(c&d);k=0x8f1bbcdc;}else{f=b0^c^d;k=0xca62c1d6;}let t=(rl(a0,5)+f+e+k+w[j])|0;e=d;d=c;c=rl(b0,30);b0=a0;a0=t;}h=[a0,b0,c,d,e].map((x,j)=>(h[j]+x)|0);}return hex(h);}\nfunction record(s){const b=utf8(s);return{utf8_bytes:b.length,sha256:sha256(b),git_blob_sha1:sha1(utf8(\"blob \"+b.length+\"\\0\").concat(b))};}\n",
    "span_and_ascii_token_helpers": "\nfunction canon(o){return o&&typeof o===\"object\"?(Array.isArray(o)?o.map(canon):Object.fromEntries(Object.keys(o).sort().map(k=>[k,canon(o[k])]))):o;}\nfunction stable(o){return JSON.stringify(canon(o));}\nfunction utf8decode(b){return decodeURIComponent(b.map(x=>\"%\"+x.toString(16).padStart(2,\"0\")).join(\"\"));}\nfunction exactSpan(source,evidence,pin){\n const b=utf8(source),start=evidence.span.start,end=evidence.span.end;\n if(!Number.isInteger(start)||!Number.isInteger(end)||start<0||end<=start||end>b.length)throw Error(\"invalid span bounds\");\n const before=utf8decode(b.slice(0,start)),through=utf8decode(b.slice(0,end)),part=b.slice(start,end),text=utf8decode(part);\n const got=sha256(part);\n return {source_file_sha256:sha256(b),source_pin_matches:sha256(b)===pin.sha256,span_sha256:got,span_hash_matches:got===evidence.span_sha256,utf8_boundaries_valid:true,span_bytes:part.length,start_line:before.split(\"\\n\").length,end_line:through.split(\"\\n\").length-(through.endsWith(\"\\n\")?1:0),text};\n}\nfunction asciiTokenReceipt(text){\n const normalized=text.normalize(\"NFKC\");\n const nonASCII=[...new Set([...normalized].filter(c=>c.codePointAt(0)>127))];\n if(nonASCII.length)return {exact_ascii_domain:false,non_ascii_characters:nonASCII};\n return {exact_ascii_domain:true,tokens:[...new Set(normalized.toLowerCase().match(/[a-z0-9]+/g)||[])].sort()};\n}\n"
