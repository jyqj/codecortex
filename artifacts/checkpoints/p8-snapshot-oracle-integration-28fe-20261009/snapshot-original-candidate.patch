+    fn dependency_insert_runs(conn: &Connection) -> i32 {
+        [64, 8, 1]
+            .into_iter()
+            .map(|n| {
+                let sql = format!(
+                    "INSERT INTO resolution_dependencies(file_path,kind,key) VALUES{}",
+                    vec!["(?,?,?)"; n].join(",")
