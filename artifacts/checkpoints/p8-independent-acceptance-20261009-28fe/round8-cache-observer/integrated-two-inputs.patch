+def soak_cache_summary(rows, operations, start_ns, end_ns, project):
+    reads = sorted((r for r in rows if r["operation"] == "read"), key=lambda r:r.get("call_started_ns", r["offered_ns"]))
+    expected_reads = operations - (operations + 2) // 3
