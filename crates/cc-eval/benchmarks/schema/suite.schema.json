{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suite",
  "type": "object",
  "properties": {
    "engine_config": true,
    "name": {
      "type": "string"
    },
    "queries": {
      "type": "string"
    },
    "queries_digest": {
      "type": "string"
    },
    "repetitions": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "scoring": {
      "$ref": "#/$defs/ScoreProfile"
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/SourceLock"
    },
    "timeout_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "top_k": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "warmup": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "source",
    "queries",
    "queries_digest",
    "scoring",
    "repetitions",
    "warmup",
    "seed",
    "timeout_ms",
    "top_k",
    "engine_config"
  ],
  "$defs": {
    "ScoreProfile": {
      "type": "string",
      "enum": [
        "oce-compat-v1",
        "codecortex-native-v1"
      ]
    },
    "SourceLock": {
      "type": "object",
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "root",
        "digest",
        "files"
      ]
    }
  }
}