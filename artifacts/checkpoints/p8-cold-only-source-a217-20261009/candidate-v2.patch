+          P8_EXPECTED_SOURCE: ${{ github.event.pull_request.head.sha || github.sha }}
+          P8_CAPACITY_PREPARE_ALLOWED: ${{ github.repository == 'jyqj/codecortex' && runner.environment == 'github-hosted' && runner.os == 'Linux' }}
+        run: |
+          python3 scripts/p8_runner_capacity.py --scale "$SCALE" \
+            --output "$RUNNER_TEMP/p8-cold-capacity-$SCALE-$SHARD" --prepare-ephemeral
+      - name: Preserve capacity observations and any unsuccessful preparation
+        if: always()
+        uses: actions/upload-artifact@v4
