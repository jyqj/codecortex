          "line": 68,
          "text": "pub fn bootstrap(values: &[f64], seed: u64) -> Option<Interval> {"
        },
        {
          "line": 69,
          "text": "    if values.is_empty() || values.iter().any(|v| !v.is_finite()) {"
        },
        {
          "line": 70,
          "text": "        return None;"
        },
        {
          "line": 71,
          "text": "    }"
        },
        {
          "line": 72,
          "text": "    let mean = values.iter().sum::<f64>() / values.len() as f64;"
        },
        {
          "line": 73,
          "text": "    let mut s = seed;"
        },
        {
          "line": 74,
          "text": "    let mut draws = Vec::with_capacity(2000);"
        },
        {
          "line": 75,
          "text": "    for _ in 0..2000 {"
        },
        {
          "line": 76,
          "text": "        let mut total = 0.0;"
        },
        {
          "line": 77,
          "text": "        for _ in values {"
        },
        {
          "line": 78,
          "text": "            total += values[(next(&mut s) as usize) % values.len()];"
        },
        {
          "line": 79,
          "text": "        }"
        },
        {
          "line": 80,
          "text": "        draws.push(total / values.len() as f64);"
        },
        {
          "line": 81,
          "text": "    }"
        },
        {
          "line": 82,
          "text": "    draws.sort_by(f64::total_cmp);"
