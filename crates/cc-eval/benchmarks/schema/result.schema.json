{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Row",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "diagnostic": {
      "type": [
        "string",
        "null"
      ]
    },
    "elapsed_us": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "hits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hit"
      }
    },
    "raw_digest": {
      "type": "string"
    },
    "raw_path": {
      "type": "string"
    },
    "repetition": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "status": {
      "$ref": "#/$defs/ResultStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "case_id",
    "repetition",
    "status",
    "elapsed_us",
    "hits",
    "raw_path",
    "raw_digest"
  ],
  "$defs": {
    "ByteSpan": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "Hit": {
      "type": "object",
      "properties": {
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "evidence_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "qname": {
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "symbol_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ResultStatus": {
      "type": "string",
      "enum": [
        "success",
        "no_match",
        "partial",
        "timeout",
        "tool_error",
        "protocol_error",
        "cancelled"
      ]
    }
  }
}