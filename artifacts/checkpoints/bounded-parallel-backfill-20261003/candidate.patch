+pub(crate) fn drain_worker_batch_parallel(
+    db: &Arc<IndexDb>,
+    subsystem: &SemanticSubsystem,
+    services: &QueryServices,
+    provider: &dyn EmbeddingProvider,
+    resolve_input: &(dyn Fn(&ClaimedTask) -> CcResult<Option<DocumentInput>> + Sync),
