+        let mut reference =
+            open_scratch(&directory.path().join("reference.sqlite3"), limits).unwrap();
+        let mut actual_bytes = 0;
+        let mut expected_bytes = 0;
+        for side in 0..2 {
+            let mut input = values.to_vec();
+            if side == 1 {
+                input.reverse();
+            }
+            let source = source_rows(&input);
+            assert_eq!(
