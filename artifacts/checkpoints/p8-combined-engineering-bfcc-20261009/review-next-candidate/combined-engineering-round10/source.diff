+#[test]
+fn max_rowid_boundaries_use_tail_lookup_with_a_real_scan_control() {
+    use std::io::Write;
+
+    let mut observations = Vec::new();
+    for n in [0, 1, 257] {
+        let conn = connection();
+        let tx = conn.unchecked_transaction().unwrap();
+        original(&tx, &units(n)).unwrap();
+        for table in ["files", "literal_index"] {
+            let sql = format!("SELECT coalesce(max(rowid),0) FROM {table}");
+            let mut statement = tx.prepare(&sql).unwrap();
+            statement.reset_status(StatementStatus::FullscanStep);
+            let maximum: i64 = statement.query_row([], |row| row.get(0)).unwrap();
+            let max_steps = statement.get_status(StatementStatus::FullscanStep);
+            assert_eq!(maximum, n as i64, "{table} at {n} rows");
+            assert_eq!(max_steps, 0, "MAX must not traverse {table} rows");
+            let plan = tx
+                .prepare(&format!("EXPLAIN {sql}"))
+                .unwrap()
+                .query_map([], |row| {
+                    Ok((
+                        row.get::<_, i64>(0)?,
+                        row.get::<_, String>(1)?,
+                        row.get::<_, i64>(2)?,
+                        row.get::<_, i64>(3)?,
+                        row.get::<_, i64>(4)?,
+                        row.get::<_, Option<String>>(5)?,
+                    ))
+                })
+                .unwrap()
+                .collect::<rusqlite::Result<Vec<_>>>()
+                .unwrap();
+            assert!(plan.iter().any(|op| op.1 == "Last"), "{plan:?}");
+            // A bypassed Prev can remain in VDBE after min/max early-out.
+            // Check executed traversal counters, not opcode absence.
+            let mut control = tx
+                .prepare(&format!("SELECT coalesce(sum(rowid),0) FROM {table}"))
+                .unwrap();
+            control.reset_status(StatementStatus::FullscanStep);
+            let sum: i64 = control.query_row([], |row| row.get(0)).unwrap();
+            let scan_steps = control.get_status(StatementStatus::FullscanStep);
+            assert_eq!(sum, (n * (n + 1) / 2) as i64);
+            if n > 1 {
+                assert!(scan_steps > 0, "scan counter must observe the SUM control");
+            }
+            observations.push(serde_json::json!({
+                "table":table,"rows":n,"maximum":maximum,
+                "max_fullscan_steps":max_steps,"sum_fullscan_steps":scan_steps,
+                "explain":plan
+            }));
+        }
+    }
+    // Direct stderr preserves non-timing control evidence even under the
+    // default Rust test harness; no --nocapture or benchmark option is needed.
+    writeln!(
+        std::io::stderr().lock(),
+        "P8_FTS_MAX_ROWID_CONTROL={}",
+        serde_json::json!({"timing_measurement":false,"observations":observations})
+    )
+    .unwrap();
+}
