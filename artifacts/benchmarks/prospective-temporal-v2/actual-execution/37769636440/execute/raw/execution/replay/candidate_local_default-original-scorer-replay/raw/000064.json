        "text": "\n\n    def write_ns(self, payload):\n        size = len(payload)\n        if size > self.maxsize:\n            raise NetstringMessageTooLong(size, self.maxsize)\n        data = str(size).encode('ascii') + b':' + payload + b','\n        self.bsock.send(data)"
