+#[test]
+fn private_fts_flush_full_error_abandons_actual_rebuild_without_publication() {
+    // This injects an error between private base writes and flush inside the
+    // real rebuild owner. It is not public-entry end-to-end fault injection or
+    // evidence of DirectWriter's physical rollback with journal_mode=OFF.
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("live.db");
+    let db = IndexDb::open(&path).unwrap().0;
+    db.replace_files_batch(&units(1)).unwrap();
+    let generation = db.generation().unwrap();
+    let before = dump(&db.read_conn().unwrap());
+    let mut files = units(1);
+    files[0].outcome.summary = (0..131_072)
+        .map(|n| format!("flush{n:08} "))
+        .collect::<String>();
+    let reached_flush = std::cell::Cell::new(false);
+    let result = db.rebuild_with_temp_db(|conn| {
+        assert!(can_defer_snapshot_fts(conn)?);
+        let mirror = SnapshotFtsWindow::begin(conn, &files)?
+            .expect("canonical owned transaction must select the rowid window");
+        IndexDb::insert_snapshot_file_data_deferred_fts(conn, &files[0], None)?;
+        assert_eq!(count(conn, "files"), 1);
+        assert_eq!(count(conn, "files_fts"), 0);
+        let pages: i64 = conn.query_row("PRAGMA page_count", [], |row| row.get(0)).unwrap();
+        let free: i64 = conn.query_row("PRAGMA freelist_count", [], |row| row.get(0)).unwrap();
+        let page_size: i64 = conn.query_row("PRAGMA page_size", [], |row| row.get(0)).unwrap();
+        assert!(files[0].outcome.summary.len() as i64 > free * page_size);
+        let cap: i64 = conn
+            .query_row(&format!("PRAGMA max_page_count={pages}"), [], |row| row.get(0))
+            .unwrap();
+        assert_eq!(cap, pages);
+        reached_flush.set(true);
+        let error = mirror.flush(conn).expect_err("FTS content must exceed the fixed page cap");
+        // The existing production db_err deliberately stores SQLite's display
+        // message, not its numeric code. Assert that exact SQLITE_FULL message.
+        assert!(
+            matches!(&error, cc_model::CcError::Database(message) if message == "database or disk is full"),
+            "unexpected flush error: {error:?}"
+        );
+        eprintln!(
+            "P8_FTS_FLUSH_FULL={}",
+            serde_json::json!({
+                "scope":"private flush plus actual temp rebuild owner",
+                "page_count_before_flush":pages,"freelist_count":free,
+                "page_size":page_size,"max_page_count":cap,
+                "summary_bytes":files[0].outcome.summary.len(),
+                "actual_mapped_error":error.to_string(),
+                "public_end_to_end_injection":false,
+                "direct_writer_physical_rollback_claim":false
+            })
+        );
+        Err(error)
+    });
+    assert!(reached_flush.get());
+    assert!(result.is_err());
+    assert_eq!(db.generation().unwrap(), generation);
+    assert_eq!(dump(&db.read_conn().unwrap()), before);
+    drop(db);
+    let reopened = IndexDb::open(&path).unwrap().0;
+    assert_eq!(reopened.generation().unwrap(), generation);
+    assert_eq!(dump(&reopened.read_conn().unwrap()), before);
+}
