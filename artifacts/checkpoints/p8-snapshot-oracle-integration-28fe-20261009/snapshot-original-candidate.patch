+    fn dependency_rows(conn: &Connection) -> Vec<(i64, String, String, String)> {
+        let mut statement = conn
+            .prepare("SELECT rowid,file_path,kind,key FROM resolution_dependencies ORDER BY rowid")
+            .unwrap();
+        statement
